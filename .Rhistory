, position = c(2.6, 5.5)
) %>%
include_text(value = "plots"
, position = c(4.5, 9.5)
, size = 16
, color = "black"
, font[1]
) %>%
include_text(value = "Tratamiento"
, position = c(2.6, 2.6)
, size = 16
, color = "blue"
, font[3]
) %>%
include_text(value = "d1"
, position = c(2.6, 1.9)
, size = 15
, color = "red"
, font[1]
) %>%
